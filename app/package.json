{
  "name": "meatup-club",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "deploy": "npm run verify && wrangler deploy",
    "lint": "eslint . --max-warnings 0",
    "preview": "npm run build && wrangler pages dev ./build/client",
    "smoke:production": "node scripts/smoke-production.mjs",
    "typecheck": "react-router typegen && tsc",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:d1": "bash scripts/verify-d1-schema.sh",
    "test:e2e": "playwright test",
    "test:secrets": "node scripts/check-secret-fixtures.mjs",
    "test:stability": "node scripts/run-test-stability.mjs",
    "test:watch": "vitest watch",
    "verify": "npm run lint && npm run test:secrets && npm run typecheck && npm run test:coverage && npm run test:d1 && npm run build && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@react-router/cloudflare": "8.3.0",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "svix": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "wrangler": {
      "@cloudflare/workers-types": "^4.20260701.1"
    }
  }
}
